# Copie para server/.env e preencha.
# Em DESENVOLVIMENTO basta o ADMIN_EMAIL/ADMIN_PASSWORD: o banco cai para
# SQLite e os arquivos para server/uploads/.
# Em PRODUCAO o processo se recusa a subir sem tudo o que esta marcado.

NODE_ENV=development
PORT=3333

# --- Banco (obrigatorio em producao) ---
# Pooler do Supabase, porta 6543. E o que a aplicacao usa.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexao direta, porta 5432. So a migracao usa.
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Acesso ao painel (obrigatorio em producao) ---
ADMIN_EMAIL=secretaria@paroquiasantaluzia.com.br
# Em producao: 10+ caracteres e nunca a deste exemplo, senao a API nao sobe.
# Depois de 8 senhas erradas seguidas, o IP espera 15 minutos.
ADMIN_PASSWORD=troque-esta-senha
# Segredo que assina o token de sessao. Minimo 16 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Arquivos (obrigatorio em producao) ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# A chave service_role, NAO a anon. Ela da acesso total ao banco e so pode
# existir no servidor -- nunca no bundle do front.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=eventos

# --- CORS (obrigatorio em producao) ---
# Separe por virgula. Sem barra no final (o codigo normaliza, mas evite).
CORS_ORIGINS=http://localhost:5173

# Endereco publico desta API. So importa no modo de disco local.
PUBLIC_URL=http://localhost:3333
