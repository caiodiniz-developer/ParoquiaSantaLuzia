{
  "name": "paroquia-santa-luzia-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "banco:dev": "prisma db push --schema prisma/schema.dev.prisma",
    "banco:prod": "prisma db push --schema prisma/schema.prisma",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.46.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
